{
  "schemaVersion": "pump-lighting-contract-v1",
  "coordinateSystem": {
    "up": "+Y",
    "shaft": "+X",
    "front": "+Z",
    "azimuthZero": "+Z",
    "positiveAzimuth": "toward +X"
  },
  "colorManagement": {
    "working": "Linear-sRGB",
    "output": "sRGB",
    "toneMapping": "ACESFilmic",
    "exposure": 1.0
  },
  "lights": {
    "key": { "azimuth": -35, "elevation": 45, "kelvin": 5000, "relativeIntensity": 1.0, "castsShadow": true },
    "fill": { "azimuth": 55, "elevation": 20, "kelvin": 6500, "relativeIntensity": 0.28, "castsShadow": false },
    "rim": { "azimuth": 145, "elevation": 35, "kelvin": 4000, "relativeIntensity": 0.45, "castsShadow": false },
    "top": { "azimuth": 0, "elevation": 85, "kelvin": 5200, "relativeIntensity": 0.18, "castsShadow": false },
    "environment": { "source": "local RoomEnvironment", "relativeIntensity": 0.33 }
  },
  "pointerFollow": {
    "finePointerOnly": true,
    "keyAzimuthRange": 12,
    "keyElevationRange": 6,
    "fillCounterMotionRatio": 0.35,
    "modelParallaxDegrees": 2.5,
    "settleMilliseconds": 280,
    "returnDelayMilliseconds": 450
  },
  "scenes": {
    "curtain": { "azimuth": -20, "elevation": 35 },
    "system": { "azimuth": -25, "elevation": 65 },
    "anomaly": { "azimuth": -35, "elevation": 48 },
    "isolated": { "azimuth": -35, "elevation": 45 },
    "exploded": { "azimuth": -50, "elevation": 38 },
    "reassembled": { "azimuth": -30, "elevation": 45 }
  }
}
